[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/gd_demo.gd" id="1_gd"]
[ext_resource type="Theme" path="res://themes/gd_theme.tres" id="2_theme"]

[sub_resource type="StyleBoxFlat" id="sb_page"]
content_margin_left = 20.0
content_margin_top = 18.0
content_margin_right = 20.0
content_margin_bottom = 18.0
bg_color = Color(0.043, 0.059, 0.086, 1)

[sub_resource type="StyleBoxFlat" id="sb_ball"]
bg_color = Color(0.541, 0.388, 0.824, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[node name="GdDemo" type="PanelContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
theme_override_styles/panel = SubResource("sb_page")
script = ExtResource("1_gd")

[node name="Col" type="VBoxContainer" parent="."]
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Title" type="Label" parent="Col"]
theme_override_colors/font_color = Color(0.902, 0.929, 0.961, 1)
theme_override_font_sizes/font_size = 26
text = "GDScript 场景 · gd_demo.gd"

[node name="Desc" type="Label" parent="Col"]
theme_override_font_sizes/font_size = 13
text = "这个场景没有 Angular，也没有 JS：节点在 .tscn 里静态摆好，外观来自 themes/gd_theme.tres，行为写在 scripts/gd_demo.gd。构建产物里根本没有它，Angular 侧不知道它存在。"
autowrap_mode = 3

[node name="Card" type="PanelContainer" parent="Col"]
size_flags_horizontal = 3

[node name="CardCol" type="VBoxContainer" parent="Col/Card"]

[node name="CardTitle" type="Label" parent="Col/Card/CardCol"]
theme_override_colors/font_color = Color(0.498, 0.82, 1, 1)
theme_override_font_sizes/font_size = 17
text = "GDScript 手写计数"

[node name="CountRow" type="HBoxContainer" parent="Col/Card/CardCol"]

[node name="PlusBtn" type="Button" parent="Col/Card/CardCol/CountRow"]
text = "计数 +1"

[node name="MinusBtn" type="Button" parent="Col/Card/CardCol/CountRow"]
text = "计数 -1"

[node name="ResetBtn" type="Button" parent="Col/Card/CardCol/CountRow"]
text = "清零"

[node name="Count" type="Label" parent="Col/Card/CardCol/CountRow"]
theme_override_colors/font_color = Color(0.902, 0.929, 0.961, 1)
theme_override_font_sizes/font_size = 24
text = "0"

[node name="Spring" type="Control" parent="Col/Card/CardCol/CountRow"]
size_flags_horizontal = 3

[node name="Tick" type="Label" parent="Col/Card/CardCol/CountRow"]
theme_override_font_sizes/font_size = 12
text = "帧 0"

[node name="Bar" type="ProgressBar" parent="Col/Card/CardCol"]
custom_minimum_size = Vector2(0, 14)
size_flags_horizontal = 3
value = 0
show_percentage = false

[node name="Stat" type="Label" parent="Col/Card/CardCol"]
theme_override_font_sizes/font_size = 12
text = "FPS —"

[node name="Stage" type="PanelContainer" parent="Col"]
custom_minimum_size = Vector2(0, 150)
size_flags_horizontal = 3

[node name="Inner" type="Control" parent="Col/Stage"]
clip_contents = true

[node name="Ball" type="Panel" parent="Col/Stage/Inner"]
custom_minimum_size = Vector2(40, 40)
theme_override_styles/panel = SubResource("sb_ball")

[node name="Nav" type="HBoxContainer" parent="Col"]

[node name="NavLabel" type="Label" parent="Col/Nav"]
theme_override_font_sizes/font_size = 12
text = "切场景："

[node name="ToMain" type="Button" parent="Col/Nav"]
text = "主界面"

[node name="ToHybrid" type="Button" parent="Col/Nav"]
text = "混合控制"

[node name="ToPlain" type="Button" parent="Col/Nav"]
text = "纯 JS 场景"

[node name="NavHint" type="Label" parent="Col/Nav"]
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 12
text = "这里没有 Angular 应用要销毁，直接 change_scene_to_file 就行"
