{
  "$schema": "./node_modules/godot-angular/builder/config/schema.json",
  "version": 1,
  "projects": {
    "demo": {
      "projectType": "application",
      "root": "src",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "godot-angular:application",
          "options": {
            "entries": ["src/main.ts", "src/hybrid/hybrid.ts", "src/plain/plain-js.ts"],
            "tsConfig": "tsconfig.json",
            "outputPath": "dist",
            "resRoot": "res://dist",
            "styles": ["src/global.scss"],
            "optimization": false,
            "sourceMap": false
          },
          "configurations": {
            "development": { "optimization": false },
            "production": { "optimization": true }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "godot-angular:vitest",
          "options": {
            "tsConfig": "tsconfig.json",
            "outputPath": "dist-engine-test",
            "resRoot": "res://dist-engine-test",
            "optimization": false,
            "sourceMap": false,
            "specInclude": ["tests/engine/*.spec.ts"],
            "engine": {
              "projectPath": ".",
              "scene": "res://tests/engine_vitest.tscn",
              "connectTimeout": 30000,
              "godotBin": "./bin"
            }
          }
        }
      }
    }
  }
}
